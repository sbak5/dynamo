#!/bin/bash
#SBATCH --job-name=dynamo-repro-gb200-4x4
#SBATCH --account=nemotron_sw_resiliency
#SBATCH --partition=batch
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=4
#SBATCH --time=01:00:00
set -euo pipefail
IMAGE="${IMAGE:-/lustre/fs1/portfolios/coreai/projects/coreai_resiliency_osiris/users/sbak/containers/dynamo-vllm-runtime-1.3.0.sqsh}"
MODEL="${MODEL:-Qwen/Qwen2.5-7B-Instruct}"
RUN_ID="${RUN_ID:?RUN_ID must match the frontend job}"
WHEELHOUSE_NAME="${WHEELHOUSE_NAME:-latest}"
HOST_HOME="$HOME"
LUSTRE_MOUNT="$(realpath "$HOME/lustre")"
RUN_DIR="${LUSTRE_MOUNT}/dynamo_repro/runs/$RUN_ID"
LOGDIR="$RUN_DIR/logs"
mkdir -p "$LOGDIR"
until [ -s "$RUN_DIR/shared/infra_ip.txt" ]; do sleep 2; done
INFRA_IP="$(cat "$RUN_DIR/shared/infra_ip.txt")"
mapfile -t NODES < <(scontrol show hostnames "$SLURM_NODELIST")
[ "${#NODES[@]}" -eq 2 ]
PREFILL_NODE="${PREFILL_NODE:-${NODES[0]}}"
DECODE_NODE="${DECODE_NODE:-${NODES[1]}}"
export INNER_B64=""
echo "[4x4] prefill=$PREFILL_NODE decode=$DECODE_NODE infra=$INFRA_IP"
launch_role() {
local role="$1" node="$2"
ROLE="$role" srun --overlap --nodes=1 --ntasks=1 --gpus=4 --nodelist="$node" --container-image="$IMAGE" --container-mounts="${HOST_HOME}:${HOST_HOME},${LUSTRE_MOUNT}:${LUSTRE_MOUNT}" --export=ALL,ROLE,INNER_B64,INFRA_IP,HOST_HOME,WHEELHOUSE_NAME,MODEL,LOGDIR bash -lc 'echo "$INNER_B64" | base64 -d | bash'
}
launch_role prefill "$PREFILL_NODE" &
prefill_pid=$!
launch_role decode "$DECODE_NODE" &
decode_pid=$!
wait "$prefill_pid"
wait "$decode_pid"
